<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Automation Exercise Suite" thread-count="5">

    <listeners>
        <listener class-name="automation_excercise_listeners.Listerner"/>
        <listener class-name="automation_excercise_listeners.RetryTransformer"/>
    </listeners>
    
    <test name="All UI Tests">
        <classes>
            <class name="automation_excercise_tests.LoginTest"/>
            <class name="automation_excercise_tests.ProductTest"/>
            <class name="automation_excercise_tests.SearchTest"/>
            <class name="automation_excercise_tests.CartTest"/>
        </classes>
    </test>

</suite>